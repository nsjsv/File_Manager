Name:           file-manager
Version:        @SEMVER@
Release:        1%{?dist}
Summary:        Linux desktop file manager written in Rust and Iced

License:        GPL-3.0-or-later
URL:            https://github.com/nsjsv/File_Manager
BuildArch:      x86_64

# Runtime commands not covered by automatic soname dependencies.
Requires:       wl-clipboard, xdg-utils
Suggests:       7zip, ffmpeg, ffmpegthumbnailer, gvfs-smb, gvfs-mtp, gvfs-gphoto2, gvfs-afc, poppler-utils, libreoffice, libsecret

%description
Multi-column file manager with previews (text, Markdown, archives, PDF,
Office, images, audio and video), virtualized large-directory views and an
optional indexed search service (file-manager-search.service, enabled by the
user via systemctl --user).

%install
bash "@PAYLOAD_SCRIPT@" "%{buildroot}" "@APP_BINARY@" "@DAEMON_BINARY@"

%files
%license /usr/share/licenses/file-manager/LICENSE
%doc /usr/share/doc/file-manager/matugen.md
/usr/bin/file-manager
/usr/lib/file-manager/file-searchd
/usr/lib/systemd/user/file-manager-search.service
/usr/share/applications/file-manager.desktop
/usr/share/icons/hicolor/512x512/apps/file-manager.png
/usr/share/file-manager/matugen/file-manager-colors.toml
/usr/share/dbus-1/services/io.github.nsjsv.FileManager.service

%changelog
